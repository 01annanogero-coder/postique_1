# Postique self-hosted configuration
# Copy to .env and change the values for your installation.

NODE_ENV=production
PORT=3000
APP_URL=http://localhost:3000
DATA_DIR=./data
MAIL_FROM_DOMAIN=example.com
# APP_SECRET is generated automatically at DATA_DIR/.app-secret if omitted.
# Set an explicit value if you run multiple processes or move the data directory.
# APP_SECRET=replace-with-at-least-32-random-characters
SECURE_COOKIES=false
ALLOW_SIGNUPS=false

# Inbound SMTP. Point your domain's MX record at this host and allow the port.
INBOUND_SMTP_ENABLED=true
INBOUND_SMTP_HOST=0.0.0.0
INBOUND_SMTP_PORT=2525
INBOUND_DOMAIN=in.postique.local
INBOUND_MAX_BYTES=26214400
# Optional STARTTLS certificate and key (PEM paths or PEM contents).
INBOUND_TLS_KEY=
INBOUND_TLS_CERT=
# Optional raw HTTP inbound bridge for Postfix/Haraka. Send X-Postique-Inbound-Secret.
INBOUND_HTTP_SECRET=

# Outbound delivery:
#   file   -> write .eml files to DATA_DIR/outbox (safe local testing)
#   smtp   -> relay through SMTP_URL
#   direct -> connect directly to recipient MX servers on port 25
#   http   -> send DKIM-signed raw MIME to an HTTP mail gateway
MAIL_TRANSPORT=file
SMTP_URL=
MAIL_ADAPTER_URL=
MAIL_ADAPTER_TOKEN=
MAIL_ADAPTER_TIMEOUT_MS=20000
SMTP_HELO_NAME=postique.local
SMTP_DIRECT_PORT=25
SPF_RECORD=v=spf1 a mx ~all
DKIM_SELECTOR=postique

# Application end-user authentication
AUTH_ACCESS_TOKEN_TTL=3600
AUTH_REFRESH_TOKEN_DAYS=30
AUTH_MAGIC_LINK_MINUTES=15
AUTH_OTP_MINUTES=10
AUTH_PASSWORD_MIN_LENGTH=8
# Expose generated magic links in API/admin responses. Useful with the file transport.
# AUTH_DEBUG_LINKS=true

# Embedded inbox
EMBED_TOKEN_MINUTES=60

# Ephemeral email verification
VERIFY_TOKEN_MINUTES=30
VERIFY_RETENTION_HOURS=24
VERIFY_MAX_PER_HOUR=5
VERIFY_PROOF_MINUTES=15
# Optional Cloudflare Turnstile for public-key verification requests.
# TURNSTILE_SECRET_KEY=
# VERIFY_DEBUG_LINKS=true

# BYOA campaigns
CAMPAIGN_BATCH_SIZE=50
CAMPAIGN_MAX_RECIPIENTS_PER_REQUEST=5000
CAMPAIGN_MAX_RECIPIENTS=100000
CAMPAIGN_RETENTION_DAYS=30

# Limits
SEND_LIMIT_PER_HOUR=1000
MONTHLY_SEND_LIMIT=10000
PUBLIC_SEND_PER_MINUTE=20
PUBLIC_KEY_PER_MINUTE=60
PUBLIC_SEND_PER_DAY=500
PUBLIC_VERIFY_PER_HOUR=5
PUBLIC_VERIFY_PER_DAY=20
MAX_ATTACHMENT_BYTES=10485760
MAX_ASSET_BYTES=10485760

# DNS checks for domain verification
DNS_VERIFICATION_ENABLED=true
ALLOW_MANUAL_DOMAIN_VERIFICATION=true

# Webhooks. Private destinations are disabled by default for production safety.
ALLOW_PRIVATE_WEBHOOKS=false
WEBHOOK_TIMEOUT_MS=10000

WORKER_ENABLED=true
WORKER_INTERVAL_MS=1000
WORKER_CONCURRENCY=1
LOG_LEVEL=info
